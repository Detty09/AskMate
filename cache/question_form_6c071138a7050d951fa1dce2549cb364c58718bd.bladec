<?php $_shouldextend[1]=1; ?>

<?php $this->startSection("title", isset($question) ? "Edit question" : "Add new question"); ?>

<?php $this->startSection('content'); ?>
 <h1><?php echo \htmlentities(isset($question) ? "Edit question" : "Add new question"??'', ENT_QUOTES, 'UTF-8', false); ?></h1>
 <form action= <?php echo \htmlentities(isset($question) ? "/update-question" : "/submit-question"??'', ENT_QUOTES, 'UTF-8', false); ?> method="POST">

 <?php if( isset($question) ): ?>
 <input type="hidden" name="question-id" value="<?php echo \htmlentities($question->id??'', ENT_QUOTES, 'UTF-8', false); ?>">
 <?php endif; ?>
 <input
 type="text"
 name="question-title"
 value="<?php echo \htmlentities(isset($question) ? htmlspecialchars($question->title) : ""??'', ENT_QUOTES, 'UTF-8', false); ?>"
 placeholder="Question title"
 required>
 <input
 type="text"
 name="question-message"
 placeholder="Message"
 value="<?php echo \htmlentities(isset($question) ? htmlspecialchars($question->message) : ""??'', ENT_QUOTES, 'UTF-8', false); ?>"
 required>
 <button type="submit">Submit</button>
 </form>
<?php $this->stopSection(); ?>
<?php if (isset($_shouldextend[1])) { echo $this->runChild("layouts.main"); } ?>